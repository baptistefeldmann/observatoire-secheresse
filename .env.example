# Copier en .env (jamais commité) et renseigner les valeurs.

# --- Docker Compose / PostGIS ---
# Un nom et un port distincts par département si plusieurs instances tournent sur la même machine.
COMPOSE_PROJECT_NAME=secheresse_vendee
POSTGRES_HOST=localhost
# 5433 plutôt que 5432, souvent déjà pris par une autre instance PostgreSQL.
POSTGRES_PORT=5433
# Interface d'écoute : 127.0.0.1 (défaut, accès distant par tunnel SSH) ou 0.0.0.0 (réseau local).
POSTGRES_BIND=127.0.0.1
POSTGRES_USER=secheresse
POSTGRES_PASSWORD=
POSTGRES_DB=secheresse_vendee

# Rôle en lecture seule utilisé par QGIS et le dashboard.
POSTGRES_LECTEUR_USER=lecteur
POSTGRES_LECTEUR_PASSWORD=

# --- Dossier de configuration (facultatif, défaut : config/) ---
# SECHERESSE_CONFIG=config

# --- Météo-France, portail-api.meteofrance.fr (API Climatologie) : non utilisée en V1 ---
# Les données SIM de data.gouv.fr suffisent (délai d'un jour, docs/spikes/01_sim_meteo.md).
METEOFRANCE_API_KEY=

# --- Microsoft Planetary Computer [V2] : clé facultative (quota élargi), accès anonyme sinon ---
PC_SDK_SUBSCRIPTION_KEY=

# --- Copernicus Data Space Ecosystem [V2, non utilisé : Sentinel-2 via Planetary Computer] ---
COPERNICUS_USER=
COPERNICUS_PASSWORD=

# --- DagsHub (remote DVC) : jeton dans DagsHub › Settings › Tokens, puis `make dvc-auth` ---
DAGSHUB_USER=
DAGSHUB_TOKEN=
